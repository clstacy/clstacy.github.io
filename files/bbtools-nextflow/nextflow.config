// Pipeline parameters (override on the command line with --name value).
params {
    samplesheet = 'samplesheet.csv'
    reference   = 'lambda.fa.gz'
    contaminant = 'phix'          // BBDuk keyword or a fasta path
    outdir      = 'results'
}

// Defaults for every process; profiles below change where and how they run.
process {
    cpus   = 2
    memory = 2.GB
    withName: MAP { memory = 4.GB }
}

profiles {
    // Laptop: BBTools already on PATH (conda env, or the unpacked download).
    standard {
        process.executor = 'local'
    }
    // Container from Biocontainers; version pinned so results are reproducible.
    docker {
        docker.enabled    = true
        process.container = 'quay.io/biocontainers/bbmap:40.02--h09cc210_0'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = 'quay.io/biocontainers/bbmap:40.02--h09cc210_0'
    }
    conda {
        conda.enabled = true
        process.conda = 'bioconda::bbmap=40.02'
    }
    // Cluster: same processes, SLURM executor, resources per label.
    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
        process.cpus     = 4
        process.memory   = 8.GB
        process.time     = 2.h
        withName: MAP { cpus = 8; memory = 32.GB }
    }
}

// Provenance for every run.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
